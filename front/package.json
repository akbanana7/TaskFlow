{
  "name": "taskflowfront",
  "version": "0.0.1",
  "description": "The frontend/ui/authenticator of a task managment system",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint public/**/*.js",
    "start": "node server.js"
  },
  
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "public/**/*.js",
      "!public/**/*.test.js"
    ],
    "coverageDirectory": "coverage"
  }
}
